server {
    listen 80;
    server_name {{ vault_domain }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ vault_domain }};

    ssl_certificate {{ vault_certs_path }}/fullchain.pem;
    ssl_certificate_key {{ vault_certs_path }}/privkey.pem;

    ssl_certificate_key /etc/letsencrypt/live/{{ vault_domain }}/privkey.pem;
    location / {
        proxy_pass https://127.0.0.1:8200;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}